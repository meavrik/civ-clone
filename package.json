{
  "name": "civ-clone",
  "private": true,
  "scripts": {
    "dev": "vite apps/web",
    "build": "tsc -b && vite build apps/web",
    "preview": "vite preview apps/web",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "headless": "vite-node --script tools/headless/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ]
}
